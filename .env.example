# Node 24 LTS. Never commit .env or real access codes.
SONIOX_API_KEY=replace_with_soniox_api_key
SONIOX_REGION=eu
# Local usage estimate in USD per audio hour (PCM TTS: 48000 bytes/second).
PRICE_STT_USD_PER_HOUR=0.12
PRICE_TTS_USD_PER_HOUR=0.70
# Optional usage logs endpoint override; normally follows SONIOX_REGION.
# SONIOX_USAGE_LOGS_URL=https://api.eu.soniox.com/v1/usage-logs
SESSION_SECRET=replace_with_at_least_32_random_characters
# Required: individual random codes of at least 16 characters. Imported as passwords
# only when users is empty. The owner's env code always restores admin access,
# even after a password change or account disable (break-glass). Protect this secret.
APP_ACCESS_CODES=fero:replace_with_random_owner_code,rodina:replace_with_different_random_code
APP_OWNER_USERNAME=fero
APP_OWNER_VOICE_NAME=my voice

PORT=3000
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: exact HTTPS origins and an initialized, writable Fly Volume.
# APP_ORIGINS=https://soniox-prekladac.fly.dev
# USAGE_DB_PATH=/data/usage.sqlite
TRUST_FLY_PROXY=false
# Enable only behind Fly Proxy with FLY_APP_NAME set and no direct public origin.
# Keep SESSION_SECRET stable across deploys so persisted logins remain valid.
SESSION_TTL_MINUTES=43200
MAX_LOGIN_ATTEMPTS=8

TTS_TRANSPORT=auto
# auto = WebSocket with one safe REST fallback; rest = emergency voice transport.
# SONIOX_TTS_WS_URL=wss://tts-rt.eu.soniox.com/tts-websocket
# SONIOX_TTS_REST_URL=https://tts-rt.eu.soniox.com/tts
ENDPOINT_DELAY_MS=1500
ENDPOINT_LATENCY_LEVEL=0
ENDPOINT_SENSITIVITY=0

MAX_SESSION_MINUTES=30
MAX_AUDIO_MB_PER_SESSION=75
MAX_TTS_REQUESTS_PER_SESSION=120
MAX_TTS_AUDIO_MB_PER_SESSION=80
MAX_ACTIVE_WS_TOTAL=3
MAX_ACTIVE_WS_PER_IP=2
MAX_USER_SESSIONS_PER_DAY=20
MAX_USER_AUDIO_MB_PER_DAY=250
MAX_USER_TTS_REQUESTS_PER_DAY=600
MAX_USER_TTS_AUDIO_MB_PER_DAY=160
MAX_USER_TTS_CHARS_PER_DAY=200000
MAX_USER_STT_MINUTES_PER_DAY=180
MAX_PREVIEW_TTS_REQUESTS_PER_HOUR=20
IDLE_TIMEOUT_SECONDS=120

# Fixed safety bounds live in speech-session.js / tts-transport.js:
# 5 queued voice chunks, 900 UTF-16 units per chunk, 128 KiB client WS frame.
# TTS first audio 3 s, idle 5 s, total 30 s; REST 15 s.
# No-config 12 s, STT connect 10 s, heartbeat 10 s, STT keepalive 10 s.
