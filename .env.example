SONIOX_API_KEY=tvoj_soniox_api_kluc
SONIOX_REGION=eu
APP_ACCESS_CODES=fero:123456,brat:654321
SESSION_SECRET=aspon_32_znakov_dlhy_nahodny_secret_123456

# Login/session
SESSION_TTL_MINUTES=720
MAX_LOGIN_ATTEMPTS=8

# Jedna WebSocket konverzácia
MAX_SESSION_MINUTES=30
MAX_AUDIO_MB_PER_SESSION=75
MAX_TTS_REQUESTS_PER_SESSION=120
MAX_TTS_AUDIO_MB_PER_SESSION=80
MAX_TTS_QUEUE=5
MAX_TTS_CHARS=900
MAX_TEXT_CHARS=40000
MAX_WS_MESSAGE_KB=128

# Fáza 2: ochrana kreditu a spojení
MAX_ACTIVE_WS_TOTAL=3
MAX_ACTIVE_WS_PER_IP=2
MAX_USER_SESSIONS_PER_DAY=20
MAX_USER_AUDIO_MB_PER_DAY=250
MAX_USER_TTS_REQUESTS_PER_DAY=600
MAX_USER_TTS_AUDIO_MB_PER_DAY=160
MAX_PREVIEW_TTS_REQUESTS_PER_HOUR=20
IDLE_TIMEOUT_SECONDS=120
NO_CONFIG_TIMEOUT_SECONDS=12
SONIOX_CONNECT_TIMEOUT_SECONDS=10
WS_HEARTBEAT_SECONDS=25
TTS_PLAYBACK_TIMEOUT_SECONDS=45

# Fáza 3: korektné ukončenie Soniox STT streamu
SONIOX_FINALIZE_TIMEOUT_SECONDS=4

# Fáza 5: AudioWorklet nevyžaduje nové secrets.

# Fáza 5.1: default rýchlejšej reakcie je 500 ms v UI/serveri; nové secrets netreba.
